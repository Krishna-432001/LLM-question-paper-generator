APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Uploaded books and papers. On a nearly full system drive, keep them on another one:
#   FILESYSTEM_SOURCES_DISK=books
#   BOOKS_STORAGE_ROOT=D:/ExamForge-storage
FILESYSTEM_SOURCES_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI provider. fake = offline deterministic (default), openai = real, claude = real.
# Switching provider needs no prompt changes: registry model names are mapped.
AI_DRIVER=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_PREMIUM=gpt-4o
OPENAI_MODEL_MID=gpt-4.1-mini
OPENAI_MODEL_CHEAP=gpt-4o-mini

# Claude (AI_DRIVER=claude)
ANTHROPIC_API_KEY=
# Claude model per job. Defaults are the low-cost choice (Sonnet writes, Haiku checks).
# CLAUDE_MODEL_PREMIUM=claude-sonnet-5-5
# CLAUDE_MODEL_MID=claude-haiku-5-5
# CLAUDE_MODEL_CHEAP=claude-haiku-5-5
# Most thinking any call may use (low|medium|high|xhigh|max); thinking is billed.
# CLAUDE_MAX_EFFORT=medium
AI_DAILY_BUDGET_INR=2000

# Embeddings: fake = offline, http = self-hosted multilingual-e5 endpoint
EMBEDDING_DRIVER=fake
EMBEDDING_ENDPOINT=http://127.0.0.1:8080/embed

# OCR for scanned books: fake | tesseract
OCR_DRIVER=fake
TESSERACT_BIN=tesseract
# Folder for OCR page images while a PDF is read (default: the system temp folder).
# OCR_WORK_DIR=D:/ExamForge-storage/tmp

# Malware scan of every upload: none (dev only) | clamav | fake (tests)
AV_DRIVER=none
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# --- Local AI with Ollama (AI_DRIVER=ollama) ---
# Free and private: the model runs on this PC. Install Ollama from
# https://ollama.com/download, then download the two models once:
#   ollama pull gemma3:12b
#   ollama pull bge-m3
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:12b
# Optional, for bigger PCs: one model per job tier. Unset tiers use OLLAMA_MODEL.
# OLLAMA_MODEL_PREMIUM=gemma3:27b
# OLLAMA_MODEL_MID=gemma3:12b
# OLLAMA_MODEL_CHEAP=gemma3:4b
# Tokens of context per call. Prompts carry book passages; keep 16384 or more.
OLLAMA_NUM_CTX=16384
# Seconds one call may take. Local generation can take minutes on a CPU.
OLLAMA_TIMEOUT=900
# How long Ollama keeps the model loaded between calls.
OLLAMA_KEEP_ALIVE=30m

# To switch to Ollama, uncomment these lines. They come last in the file,
# so they override AI_DRIVER and EMBEDDING_* above (the last value wins).
# bge-m3 is multilingual (Tamil included) and returns 1024 numbers per
# passage, which is the size the search index stores.
# AI_DRIVER=ollama
# EMBEDDING_DRIVER=ollama
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIMENSIONS=1024
